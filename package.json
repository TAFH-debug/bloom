{
  "name": "bloom",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev:desktop": "npm run tauri:dev -w @bloom/desktop",
    "dev:web": "npm run dev -w web",
    "dev:api": "cd apps/api && .venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "build:desktop": "npm run tauri:build -w @bloom/desktop",
    "build:web": "npm run build -w web",
    "lint": "npm run lint -w web --if-present"
  }
}
